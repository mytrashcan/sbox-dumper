<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../sbox-dumper.csproj" />
    <ProjectReference Include="../SboxDumper.Fixture/SboxDumper.Fixture.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <Target Name="CopyFixture" AfterTargets="Build">
    <ItemGroup>
      <FixtureFiles Include="../SboxDumper.Fixture/bin/$(Configuration)/net10.0/SboxDumper.Fixture.*" />
    </ItemGroup>
    <Copy SourceFiles="@(FixtureFiles)" DestinationFolder="$(OutDir)fixture" />
  </Target>

</Project>
